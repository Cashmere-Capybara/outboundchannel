{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outboundchannel",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "98661eed-f138-48b1-96ed-546819438525","database_name": "outboundchannel" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "aa752714b8b84b7da29bc63ddda59f4d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
